{
  "name": "python-automate",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1"
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "runArgs": [
    "--env",
    "DISPLAY=${localEnv:DISPLAY}",
    "--volume",
    "/tmp/.X11-unix:/tmp/.X11-unix:rw"
  ],
  "remoteUser": "vscode"
}
